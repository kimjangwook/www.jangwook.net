  "metadata_entries": {
    "ko": {
      "title": "화면의 정보까지 전달하기: 오디오 설명과 미디어 대안 (WCAG 1.2.3)",
      "summary": "사전 녹화 영상의 화면과 소리를 동등하게 전달하는 방법을 설명합니다. 자막·전사·오디오 설명의 차이, 본문 대안 예외와 실제 검증 결과를 바탕으로 WCAG 1.2.3 평가 프롬프트를 제공합니다.",
      "entry_sha256": "885308d7aeb99f2710ddc0d8cf2907b41ecde7f9dd45da70a74cbee1a950e90d"
    },
    "en": {
      "title": "Conveying On-Screen Information Too: Audio Description and Media Alternatives (WCAG 1.2.3)",
      "summary": "Explains how to convey the visual and audio information in prerecorded video equivalently. Provides a WCAG 1.2.3 evaluation prompt based on the differences between captions, transcripts, and audio description, the exception for media alternatives for text, and actual verification results.",
      "entry_sha256": "f530a68af2040d6bad3d05ebe4ace7bc1d2df10efa072c56ae07d4dfe3ebbeb7"
    },
