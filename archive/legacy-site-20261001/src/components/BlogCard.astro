---
import type { ImageMetadata } from 'astro';
import FormattedDate from './FormattedDate.astro';
import { getTagPath, getTagSlug } from '../lib/blog';
import type { Language } from '../lib/i18n/languages';

interface Props {
	href: string;
	title: string;
	description: string;
	pubDate: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	readingTime: number;
	readingTimeLabel?: string;
	readMoreLabel?: string;
	/** Stable content ID used by the archive's progressive loader. */
	postId?: string;
	/** Locale used for tag links. If omitted, it is inferred from href. */
	lang?: Language;
	/** Collision-safe tag slugs shared by the page rendering the card. */
	tagSlugs?: ReadonlyMap<string, string> | Record<string, string>;
	/** 뷰포트 상단(LCP 후보) 카드에만 true — lazy 대신 eager + fetchpriority로 로드 */
	eager?: boolean;
}

const {
	href,
	title,
		description,
		pubDate,
		tags,
	readingTime,
	readingTimeLabel = 'min read',
	readMoreLabel = 'Read more',
		postId,
		lang,
		tagSlugs,
} = Astro.props;

const hrefLang = href.match(/^\/(ko|en|ja|zh)(?:\/|$)/)?.[1] as Language | undefined;
const inferredLang: Language = lang ?? hrefLang ?? 'ko';
const getSlug = (tag: string) => {
	if (tagSlugs instanceof Map) return tagSlugs.get(tag) ?? getTagSlug(tag);
	return tagSlugs ? (tagSlugs as Record<string, string>)[tag] ?? getTagSlug(tag) : getTagSlug(tag);
};
---

<article class="post-card" data-post-id={postId}>
	<div class="post-card__body">
		<div class="post-card__meta">
			<time datetime={pubDate.toISOString()}>
				<FormattedDate date={pubDate} />
			</time>
			<span class="post-card__meta-dot"></span>
			<span>{readingTime} {readingTimeLabel}</span>
		</div>

		<h3><a href={href} class="post-card__link">{title}</a></h3>
		<p>{description}</p>

		<div class="post-card__footer">
			<div class="post-card__tags">
				{tags?.slice(0, 3).map((tag, index) => (
					<a
						href={getTagPath(inferredLang, getSlug(tag))}
						class:list={['post-card__tag', 'post-card__tag-link', 'mono', { 'is-primary': index === 0 }]}
						aria-label={`#${tag}`}
					>
						<span aria-hidden="true">#</span>{tag}
					</a>
				))}
			</div>
			<span class="post-card__read mono" aria-hidden="true">{readMoreLabel}</span>
		</div>
	</div>
</article>

<style>
	.post-card {
		position: relative;
		display: block;
		padding: 1.7rem 0 1.85rem;
		border-bottom: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
	}

	/* 링크는 제목만 감싼다 — 앵커 텍스트와 접근성 이름이 곧 글 제목이 된다.
	   카드 전체의 클릭 영역은 가상 요소 오버레이로 되살린다. */
	.post-card__link {
		color: inherit;
		text-decoration: none;
	}

	.post-card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.post-card__link:focus-visible {
		outline: 2px solid var(--focus-ring, var(--accent, #a33a24));
		outline-offset: 3px;
		border-radius: 2px;
	}

	.post-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		min-width: 0;
	}

	.post-card__meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--muted, var(--ink-3, #62665d));
	}

	.post-card__meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 999px;
		background: var(--ink-4);
	}

	.post-card h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.45rem, 2.4vw, 2rem);
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-wrap: balance;
		word-break: keep-all;
		overflow-wrap: anywhere;
	}

	.post-card p {
		margin: 0;
		max-width: 52rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		line-height: 1.75;
		color: var(--muted, var(--ink-2, #62665d));
		overflow-wrap: anywhere;
	}

	.post-card__footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.55rem;
	}

	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.38rem;
		min-width: 0;
	}

	.post-card__tag-link {
		position: relative;
		z-index: 1;
		text-decoration: none;
	}

	.post-card__tag-link:hover,
	.post-card__tag-link:focus-visible {
		color: var(--accent, #a33a24);
		border-color: var(--accent, #a33a24);
	}

	.post-card__tag {
		display: inline-flex;
		align-items: center;
		gap: 0.12rem;
		padding: 0.2rem 0;
		border-bottom: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
		color: var(--muted, var(--ink-3, #62665d));
		font-size: 0.66rem;
		line-height: 1;
	}

	.post-card__tag.is-primary {
		color: var(--accent, #a33a24);
		background: transparent;
		border-color: var(--accent, #a33a24);
	}

	.post-card__tag span {
		color: var(--accent, #a33a24);
	}

	.post-card__read {
		margin-left: auto;
		color: var(--accent, #a33a24);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.post-card__read::after {
		content: ' →';
	}

	@media (max-width: 540px) {
		.post-card {
			padding-block: 1.4rem 1.55rem;
		}

		.post-card h3 {
			font-size: 1.45rem;
		}

		.post-card p {
			font-size: 0.98rem;
		}

		.post-card__footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.post-card__read {
			margin-left: 0;
		}
	}

	.post-card:hover h3 {
		color: var(--accent, #a33a24);
	}
</style>
