---
import type { Language } from '../lib/i18n/languages';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const messages = {
	ko: {
		title: '글이 도움이 되셨나요?',
		description: '더 나은 콘텐츠를 작성하는 데 힘이 됩니다. 커피 한 잔으로 응원해주세요.',
		action: '커피 한 잔 보내기'
	},
	ja: {
		title: 'この記事は役に立ちましたか？',
		description: 'より良いコンテンツを作成するための力になります。コーヒー一杯で応援してください。',
		action: 'コーヒーで応援する'
	},
	en: {
		title: 'Was this helpful?',
		description: 'Your support helps me create better content. Buy me a coffee.',
		action: 'Buy me a coffee'
	},
	zh: {
		title: '这篇文章有帮助吗？',
		description: '您的支持能帮助我创作更好的内容。请我喝杯咖啡吧。',
		action: '请我喝杯咖啡'
	}
};

const message = messages[lang];
---

<div class="support-box mt-12 pt-8">
	<div class="text-center">
		<h3>
			{message.title}
		</h3>
		<p>
			{message.description}
		</p>
		<a class="support-box__link" href="https://www.buymeacoffee.com/kimjangwook" target="_blank" rel="noopener noreferrer">
			{message.action}
			<span aria-hidden="true"> →</span>
		</a>
	</div>
</div>

<style>
	.support-box {
		border-top: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
	}

	.support-box h3 {
		margin: 0 0 0.7rem;
		font-family: var(--font-serif);
		font-size: 1.65rem;
		font-weight: 500;
		color: var(--ink);
	}

	.support-box p {
		max-width: 38rem;
		margin: 0 auto 1.35rem;
		color: var(--muted, var(--ink-2, #62665d));
	}

	.support-box__link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.65rem 0.9rem;
		border: 1px solid var(--accent, #a33a24);
		border-radius: 2px;
		color: var(--accent, #a33a24);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
	}

	.support-box__link:hover,
	.support-box__link:focus-visible {
		background: color-mix(in srgb, var(--accent, #a33a24) 8%, transparent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
