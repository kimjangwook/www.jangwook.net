---
import type { Language } from '../lib/i18n/languages';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const authorInfo = {
	name: 'Kim Jangwook',
	title: {
		ko: 'AI/LLM 전문 풀스택 개발자',
		en: 'Full-Stack Developer specializing in AI/LLM',
		ja: 'AI/LLM専門フルスタック開発者',
		zh: 'AI/LLM专业全栈开发者'
	},
	bio: {
		ko: '10년 이상의 웹 개발 경험을 바탕으로 AI 에이전트 시스템, LLM 애플리케이션, 자동화 솔루션을 구축합니다. Claude Code, MCP, RAG 시스템에 대한 실전 경험을 공유합니다.',
		en: 'Building AI agent systems, LLM applications, and automation solutions with 10+ years of web development experience. Sharing practical insights on Claude Code, MCP, and RAG systems.',
		ja: '10年以上のWeb開発経験を活かし、AIエージェントシステム、LLMアプリケーション、自動化ソリューションを構築しています。Claude Code、MCP、RAGシステムの実践的な知見を共有します。',
		zh: '凭借10年以上的Web开发经验，构建AI代理系统、LLM应用程序和自动化解决方案。分享Claude Code、MCP和RAG系统的实践经验。'
	},
	aboutLabel: {
		ko: '저자 소개',
		en: 'About the Author',
		ja: '著者について',
		zh: '关于作者'
	},
	viewProfile: {
		ko: '프로필 보기',
		en: 'View Profile',
		ja: 'プロフィールを見る',
		zh: '查看简介'
	}
};
---

<section class="author-box" aria-labelledby="author-box-title">
	<h3 id="author-box-title">{authorInfo.aboutLabel[lang]}</h3>
	<div class="author-box__layout">
		<div class="author-box__avatar" aria-hidden="true">jw</div>

		<div class="author-box__content">
			<h4>{authorInfo.name}</h4>
			<p class="author-box__title">{authorInfo.title[lang]}</p>
			<p class="author-box__bio">{authorInfo.bio[lang]}</p>

			<div class="author-box__links">
				<a
					href="https://github.com/kimjangwook"
					target="_blank"
					rel="noopener noreferrer"
					class="author-box__link"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
					GitHub
				</a>
				<a
					href="https://linkedin.com/in/jangwook-kim-2590a1174"
					target="_blank"
					rel="noopener noreferrer"
					class="author-box__link"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
					LinkedIn
				</a>
				<a
					href="https://x.com/Kim_Jangwook"
					target="_blank"
					rel="noopener noreferrer"
					class="author-box__link"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
					X (Twitter)
				</a>
				<a
					href={`/${lang}/about/`}
					class="author-box__link author-box__profile"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
					</svg>
					{authorInfo.viewProfile[lang]}
				</a>
			</div>
			</div>
		</div>
</section>

<style>
	.author-box {
		margin-top: 3.5rem;
		padding-top: 1.7rem;
		border-top: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
	}

	.author-box h3 {
		margin: 0 0 1rem;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-weight: 500;
		color: var(--ink);
	}

	.author-box__layout {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 1.2rem;
		align-items: start;
	}

	.author-box h4 {
		margin: 0 0 0.2rem;
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 500;
		color: var(--ink);
	}

	.author-box__avatar {
		width: 4.25rem;
		height: 4.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent, #a33a24) 12%, var(--paper, #f4f0e8));
		color: var(--accent, #a33a24);
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-style: italic;
		font-weight: 500;
	}

	.author-box__title {
		margin: 0 0 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--accent, #a33a24);
	}

	.author-box__bio {
		margin: 0 0 0.85rem;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--muted, var(--ink-2, #62665d));
	}

	.author-box__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 1rem;
		align-items: center;
	}

	.author-box__link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.25rem;
		color: var(--muted, var(--ink-2, #62665d));
		font-size: 0.75rem;
		text-decoration: none;
	}

	.author-box__link:hover,
	.author-box__link:focus-visible,
	.author-box__profile {
		color: var(--accent, #a33a24);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.author-box__link svg {
		width: 1rem;
		height: 1rem;
		flex: none;
	}

	@media (max-width: 540px) {
		.author-box__layout {
			grid-template-columns: 1fr;
		}

		.author-box__avatar {
			width: 3.5rem;
			height: 3.5rem;
			font-size: 1.1rem;
		}
	}
</style>
