---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { filterPostsByDate } from '../lib/content';

// V3: Props 정의
interface RelatedPostItem {
  slug: string;
  score: number;
  reason: {
    ko: string;
    ja: string;
    en: string;
    zh: string;
  };
}

interface Props {
  items: RelatedPostItem[];
  language: 'ko' | 'ja' | 'en' | 'zh';
}

const { items, language } = Astro.props;

// Language-specific headings
const headings = {
  ko: '관련 글',
  ja: '関連記事',
  en: 'Related Articles',
  zh: '相关文章'
};

const heading = headings[language];

// Fetch full entries for ALL recommendations, keeping their metadata (score/reason).
// We fetch the whole list (not just the top 3) so that if a higher-ranked pick is
// unbuildable (draft/future), a lower-ranked public post can still fill the slot.
const fetched = await Promise.all(
  items.map(async (item) => {
    try {
      const post = await getEntry('blog', `${language}/${item.slug}`);
      if (!post) {
        console.warn(`[RelatedPosts] Post not found: ${language}/${item.slug}`);
        return null;
      }
      return { post, item };
    } catch (error) {
      console.error(`[RelatedPosts] Error fetching post ${item.slug}:`, error);
      return null;
    }
  })
);
const pairs = fetched.filter((entry) => entry !== null);

// Keep only recommendations whose target page is actually built. This mirrors the
// blog route's getStaticPaths (same filterPostsByDate), so a related link can never
// point at a draft/future post that 404s. Order is preserved; take the top 3.
const builtIds = new Set(filterPostsByDate(pairs.map((p) => p.post)).map((p) => p.id));

const validPosts = pairs
  .filter((p) => builtIds.has(p.post.id))
  .slice(0, 3)
  .map(({ post, item }) => ({
    slug: item.slug,
    score: item.score,
    title: post.data.title,
    description: post.data.description,
    heroImage: post.data.heroImage,
    url: `/${language}/blog/${language}/${item.slug}/`,
    reason: item.reason[language]
  }));

// Don't render if no recommendations
if (validPosts.length === 0) {
  return null;
}
---

<section class="related-posts">
  <h3 class="section-title">{heading}</h3>
  <ul class="recommendations-list">
    {validPosts.map((post) => (
      <li class="recommendation-item">
        <div class="item-content">
          <h4 class="item-title">
            <a
              class="item-link"
              href={post.url}
              onclick={`gtag('event', 'related_post_click', {
                'target_post': '${post.slug}',
                'similarity_score': ${post.score}
              })`}
            >{post.title}</a>
          </h4>
          {post.reason && (
            <p class="item-reason">{post.reason}</p>
          )}
        </div>
        {post.heroImage && (
          <div class="item-image" aria-hidden="true">
            <Image
              src={post.heroImage}
              alt=""
              width={120}
              height={80}
              loading="lazy"
            />
          </div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .related-posts {
    margin: 4.5rem 0 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 500;
    margin: 0 0 1.5rem 0;
    color: var(--ink);
    line-height: 1.4;
  }

  .recommendations-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recommendation-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
  }

  .item-link {
    text-decoration: none;
    color: inherit;
  }

  .item-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .item-link:focus-visible {
    outline: 2px solid var(--focus-ring, var(--accent, #a33a24));
    outline-offset: 3px;
    border-radius: 2px;
  }

  .recommendation-item:hover {
    color: var(--accent, #a33a24);
  }

  .item-content {
    flex: 1;
    min-width: 0;
  }

  .item-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.0625rem;
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .recommendation-item:hover .item-title {
    color: var(--accent, #a33a24);
  }

  .item-reason {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted, var(--ink-2, #62665d));
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .item-image {
    flex-shrink: 0;
    width: 120px;
    height: 80px;
    border-radius: 0;
    overflow: hidden;
    background: var(--surface, var(--paper, #f4f0e8));
    border: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
  }

  .item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Responsive design */
  @media (max-width: 640px) {
    .related-posts {
      margin: 2.5rem 0 2rem;
      padding-top: 1.25rem;
    }

    .section-title {
      font-size: 1.25rem;
      margin-bottom: 1.25rem;
    }

    .recommendation-item a {
      gap: 1rem;
      padding: 1rem 0;
    }

    .item-title {
      font-size: 0.9375rem;
      margin-bottom: 0.375rem;
    }

    .item-reason {
      font-size: 0.75rem;
    }

    .item-image {
      width: 90px;
      height: 60px;
    }
  }

  /* Print styles */
  @media print {
    .related-posts {
      display: none;
    }
  }
</style>
