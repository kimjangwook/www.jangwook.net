---
import { languages, type Language } from '../lib/i18n/languages';
import { getRouteFromUrl } from '../lib/i18n/utils';

interface Props {
	currentLang: Language;
	/** Actual equivalent URLs when a route has locale-specific availability. */
	links?: Partial<Record<Language, string>>;
}

const { currentLang, links } = Astro.props;
const currentRoute = getRouteFromUrl(Astro.url.pathname);
const switcherLabels: Record<Language, string> = {
	ko: '언어 선택',
	en: 'Select language',
	ja: '言語を選択',
	zh: '选择语言',
};

const languageOptions = Object.entries(languages).map(([lang, label]) => {
	const language = lang as Language;
	const defaultHref = `/${language}${currentRoute.replace(/{LANG}/g, language)}`;

	return {
		language,
		label,
		href: links?.[language] ?? defaultHref,
	};
});

const switcherLabel = switcherLabels[currentLang];
---

<script is:inline>
	document.documentElement.classList.add('js');
</script>

<nav class="language-switcher" aria-label={switcherLabel}>
	<div class="language-switcher__interactive">
		<label class="language-switcher__label" for="language-select">{switcherLabel}</label>
		<select id="language-select" class="language-switcher__select" data-language-select aria-label={switcherLabel}>
			{languageOptions.map((option) => (
				<option value={option.href} data-lang={option.language} selected={option.language === currentLang}>
					{option.label}
				</option>
			))}
		</select>
	</div>

	<noscript>
		<details class="language-switcher__fallback">
			<summary aria-label={switcherLabel}>{languageOptions.find((option) => option.language === currentLang)?.label}</summary>
			<div class="language-switcher__fallback-links">
				{languageOptions.map((option) => (
					<a
						href={option.href}
						aria-current={option.language === currentLang ? 'page' : undefined}
						aria-label={option.label}
						title={option.label}
					>
						<span>{option.label}</span>
					</a>
				))}
			</div>
		</details>
	</noscript>
</nav>

<style>
	.language-switcher {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-width: 0;
		padding: 0;
		border: 0;
		background: transparent;
	}

	.language-switcher__interactive {
		display: none;
		align-items: center;
	}

	:global(html.js) .language-switcher__interactive {
		display: inline-flex;
	}

	.language-switcher__select,
	.language-switcher__fallback summary {
		min-width: 5.5rem;
		min-height: 44px;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--control-border);
		border-radius: 2px;
		color: var(--ink);
		background: var(--paper-2);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1;
	}

	.language-switcher__select {
		width: 5.5rem;
		cursor: pointer;
	}

	.language-switcher__select:hover,
	.language-switcher__select:focus-visible,
	.language-switcher__fallback summary:hover,
	.language-switcher__fallback[open] summary {
		border-color: var(--accent);
	}

	.language-switcher__fallback {
		position: relative;
		display: inline-block;
	}

	.language-switcher__fallback summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		list-style: none;
	}

	.language-switcher__fallback summary::-webkit-details-marker {
		display: none;
	}

	.language-switcher__fallback-links {
		position: absolute;
		z-index: 25;
		top: calc(100% + 0.25rem);
		right: 0;
		display: grid;
		min-width: 8rem;
		padding: 0.25rem;
		border: 1px solid var(--paper-rule);
		background: var(--paper);
		box-shadow: 0 0.5rem 1.5rem color-mix(in srgb, var(--ink) 12%, transparent);
	}

	.language-switcher__fallback-links a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0.45rem 0.6rem;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-decoration: none;
	}

	.language-switcher__fallback-links a:hover,
	.language-switcher__fallback-links a:focus-visible {
		background: var(--paper-2);
	}

	.language-switcher__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { saveLanguagePreference, type SupportedLanguage } from '../lib/language-detection';

	const languageSelect = document.querySelector<HTMLSelectElement>('[data-language-select]');
	languageSelect?.addEventListener('change', () => {
		const option = languageSelect.selectedOptions[0];
		const lang = option?.dataset.lang as SupportedLanguage | undefined;
		if (!option?.value || !lang) return;

		saveLanguagePreference(lang);
		window.location.assign(option.value);
	});
</script>
