---
import { Image } from 'astro:assets';
import '../styles/article-downloads.css';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ArticleTableOfContents from '../components/ArticleTableOfContents.astro';
import AuthorBox from '../components/AuthorBox.astro';
import BuyMeACoffee from '../components/BuyMeACoffee.astro';
import BlogPostLanguageSwitcher from '../components/BlogPostLanguageSwitcher.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { getTagPath, getTagSlug } from '../lib/blog';
import { useTranslations, type Language } from '../lib/i18n/languages';
import { SITE_TITLE } from '../consts';
import RelatedPosts from '../components/RelatedPosts.astro';
import FAQ from '../components/FAQ.astro';

interface ArticleHeading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	lang: Language;
	tags?: string[];
	postId?: string;
	noindex?: boolean;
	relatedPosts?: Array<{
		slug: string;
		score: number;
		reason: { ko: string; ja: string; en: string; zh: string };
	}>;
	faq?: Array<{ question: string; answer: string }>;
	readingTime?: number;
	headings?: ArticleHeading[];
	articleSourceSha256?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	lang,
	tags,
	noindex,
	relatedPosts,
	faq,
	readingTime,
	headings = [],
	articleSourceSha256,
} = Astro.props;
const t = useTranslations(lang);

const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasTableOfContents = tocHeadings.length >= 4;
const authorNames: Record<Language, string> = {
	ko: '김장욱',
	ja: 'Kim Jangwook',
	en: 'Kim Jangwook',
	zh: 'Kim Jangwook',
};
const backToBlogLabels: Record<Language, string> = {
	ko: '블로그 목록으로',
	ja: 'ブログリストへ',
	en: 'Back to the blog',
	zh: '返回博客列表',
};
const scrollRegionLabels: Record<Language, { code: string; table: string }> = {
	ko: { code: '가로로 스크롤할 수 있는 코드 영역', table: '가로로 스크롤할 수 있는 표 영역' },
	ja: { code: '横にスクロールできるコード領域', table: '横にスクロールできる表領域' },
	en: { code: 'Code region; scroll horizontally', table: 'Table region; scroll horizontally' },
	zh: { code: '可横向滚动的代码区域', table: '可横向滚动的表格区域' },
};
const taskStateLabels: Record<Language, { checked: string; unchecked: string }> = {
	ko: { checked: '체크 표시 있음', unchecked: '체크 표시 없음' },
	ja: { checked: 'チェック表示あり', unchecked: 'チェック表示なし' },
	en: { checked: 'Checked mark present', unchecked: 'Checked mark absent' },
	zh: { checked: '有勾选标记', unchecked: '无勾选标记' },
};

/**
 * GFM task lists are static editorial checklists in an article. Keep the
 * checkbox as a visual marker, but expose the list item's text as the content
 * itself instead of presenting an unlabeled disabled form control to AT.
 * Rendering the slot here keeps the attributes in the no-JS HTML output and
 * leaves the protected Markdown source byte-for-byte unchanged.
 */
const articleSlotHtml = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const articleContent = articleSlotHtml.replace(
	/<input\b(?=[^>]*\btype\s*=\s*(?:"checkbox"|'checkbox'|checkbox)(?:\s|\/?\s*>))(?=[^>]*\bdisabled(?:\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+))?(?:\s|\/?\s*>))[^>]*>/gi,
	(inputTag) => {
		// A named checkbox already exposes its native checked/unchecked state.
		// Keep that meaning intact instead of hiding an author-provided label.
		if (/\s(?:aria-label|aria-labelledby)\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/i.test(inputTag)) {
			return inputTag;
		}

		const withoutInteractiveName = inputTag.replace(
			/\s+(?:aria-hidden|role|tabindex)\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi,
			'',
		);
		const marker = withoutInteractiveName.replace(
			/\s*\/?\s*>$/,
			' aria-hidden="true" tabindex="-1" role="presentation" data-static-task-marker="true"$&',
		);
		const state = /\schecked(?:\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+))?(?=\s|\/?\s*>)/i.test(inputTag)
			? taskStateLabels[lang].checked
			: taskStateLabels[lang].unchecked;
		return `${marker}<span class="sr-only">${state}</span>`;
	},
);

const breadcrumbs = [
	{ name: t('nav.home'), item: new URL(`/${lang}`, Astro.site).toString() },
	{ name: t('nav.blog'), item: new URL(`/${lang}/blog`, Astro.site).toString() },
	{ name: title, item: Astro.url.toString() },
];
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			articleData={{
				publishedTime: pubDate.toISOString(),
				modifiedTime: updatedDate?.toISOString(),
				author: SITE_TITLE,
				tags: tags,
			}}
			noindex={noindex}
			faqData={faq}
			breadcrumbs={breadcrumbs}
		/>
		{articleSourceSha256 && <meta name="article-source-sha256" content={articleSourceSha256} />}
	</head>

	<body>
		<ReadingProgress />
		<Header lang={lang} />
		<main id="main-content" tabindex="-1" class:list={['article-page', { 'article-page--has-toc': hasTableOfContents }]}>
			<article class="article-shell">
				<header class="article-shell__header">
					{tags && tags.length > 0 && (
						<div class="article-shell__topic" role="group" aria-label={t('nav.tags')}>
							{tags.slice(0, 4).map((tag) => (
								<a href={getTagPath(lang, getTagSlug(tag))}>#{tag}</a>
							))}
						</div>
					)}
					<h1>{title}</h1>
					<p class="article-shell__summary">{description}</p>
					<div class="article-shell__meta mono">
						<span class="article-shell__author">{authorNames[lang]}</span>
						<span aria-hidden="true">·</span>
						<time datetime={pubDate.toISOString()}>
							<span class="sr-only">{t('blog.publishedOn')}: </span><FormattedDate date={pubDate} />
						</time>
						{readingTime && (
							<>
								<span aria-hidden="true">·</span>
								<span>{readingTime} {t('blog.readTime')}</span>
							</>
						)}
						{updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								<time datetime={updatedDate.toISOString()}>
									<span class="sr-only">{t('blog.updatedOn')}: </span><FormattedDate date={updatedDate} />
								</time>
							</>
						)}
					</div>
				</header>

				<div class:list={['article-reading-grid', { 'article-reading-grid--toc': hasTableOfContents }]}>
					{hasTableOfContents && <ArticleTableOfContents headings={headings} lang={lang} />}

					<div class="article-reading-column">
						{heroImage && (
							<figure class="article-shell__hero">
								<Image
									width={720}
									height={360}
									src={heroImage}
									alt={heroImageAlt ?? title}
									class="article-shell__hero-image"
									loading="lazy"
									fetchpriority="auto"
									format="webp"
									quality={82}
								/>
							</figure>
						)}

						<div
							class="article-prose"
							data-reading-content
							data-code-scroll-label={scrollRegionLabels[lang].code}
							data-table-scroll-label={scrollRegionLabels[lang].table}
						>
							<Fragment set:html={articleContent} />
						</div>

						{faq && faq.length > 0 && <FAQ items={faq} lang={lang} />}
					</div>
				</div>

				<div class="article-shell__after">
					<BlogPostLanguageSwitcher slug={slug} currentLang={lang} />
					<BuyMeACoffee lang={lang} />
					<AuthorBox lang={lang} />
					{relatedPosts && relatedPosts.length > 0 && (
						<RelatedPosts items={relatedPosts} language={lang} />
					)}
				</div>

				<nav class="article-shell__back" aria-label={t('nav.blog')}>
					<a href={`/${lang}/blog/`} class="mono">{backToBlogLabels[lang]}</a>
				</nav>
			</article>
		</main>
		<Footer lang={lang} />

		<script is:inline type="module">
			import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

			mermaid.initialize({
				startOnLoad: false,
				theme: 'neutral',
				securityLevel: 'loose',
				flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' },
			});

			document.addEventListener('DOMContentLoaded', async () => {
				const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"] code');
				mermaidBlocks.forEach(async (block, index) => {
					const code = block.textContent;
					const pre = block.parentElement;
					if (!code || !pre) return;
					const container = document.createElement('div');
					container.className = 'mermaid-diagram';
					container.setAttribute('role', 'img');
					container.style.cssText = 'overflow:auto;max-width:100%;padding:1rem 0;';
					const id = `mermaid-${index}-${Date.now()}`;
					try {
						const { svg } = await mermaid.render(id, code);
						container.innerHTML = svg;
						pre.replaceWith(container);
					} catch (error) {
						console.error('Mermaid rendering error:', error);
					}
				});
			});
		</script>

		<script is:inline>
			let scrollTracked = false;
			function trackScrollComplete() {
				if (scrollTracked) return;
				const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
				if (scrollHeight <= 0) return;
				if ((window.scrollY / scrollHeight) * 100 >= 100) {
					scrollTracked = true;
					if (typeof gtag !== 'undefined') {
						gtag('event', 'blog_post_read_complete', {
							page_title: document.title,
							page_location: window.location.href,
							page_path: window.location.pathname,
						});
					}
				}
			}
			let scrollTimeout;
			window.addEventListener('scroll', () => {
				clearTimeout(scrollTimeout);
				scrollTimeout = setTimeout(trackScrollComplete, 100);
			});
		</script>

		<script is:inline>
			const scrollRegionRoot = document.querySelector('[data-reading-content]');
			if (scrollRegionRoot) {
				const enhanceScrollRegions = () => {
					const labels = {
						code: scrollRegionRoot.dataset.codeScrollLabel || 'Code region; scroll horizontally',
						table: scrollRegionRoot.dataset.tableScrollLabel || 'Table region; scroll horizontally',
					};
						scrollRegionRoot.querySelectorAll('pre, table').forEach((region) => {
							const isOverflowing = region.scrollWidth > region.clientWidth + 1;
							if (isOverflowing) {
								if (!region.dataset.scrollRegionPreviousRole) {
									region.dataset.scrollRegionPreviousRole = region.getAttribute('role') || '';
								}
								region.tabIndex = 0;
								region.setAttribute('aria-label', region.matches('pre') ? labels.code : labels.table);
								if (region.matches('pre')) region.setAttribute('role', 'region');
								region.dataset.scrollRegion = 'true';
							} else if (region.dataset.scrollRegion === 'true') {
								region.removeAttribute('tabindex');
								region.removeAttribute('aria-label');
								if (region.matches('pre')) {
									const previousRole = region.dataset.scrollRegionPreviousRole;
									if (previousRole) region.setAttribute('role', previousRole);
									else region.removeAttribute('role');
								}
								delete region.dataset.scrollRegionPreviousRole;
								delete region.dataset.scrollRegion;
						}
					});
				};

				enhanceScrollRegions();
				window.addEventListener('resize', enhanceScrollRegions, { passive: true });
				if (document.fonts?.ready) void document.fonts.ready.then(enhanceScrollRegions);
			}
		</script>

		<style>
			.article-page {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}

			.article-shell {
				width: min(1240px, calc(100% - 96px));
				margin: 0 auto;
				padding: clamp(3.5rem, 7vw, 5.8rem) 0 5rem;
			}

			.article-shell__header {
				max-width: 980px;
				margin: 0 auto;
				padding-bottom: 2.45rem;
				border-bottom: 1px solid var(--rule, var(--paper-rule));
			}

			.article-shell__topic {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 0.75rem;
				margin-bottom: 1.35rem;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				line-height: 1.5;
				text-transform: uppercase;
			}

			.article-shell__topic a {
				color: var(--accent, #a33a24);
				text-decoration: none;
			}

			.article-shell__topic a + a::before {
				content: '·';
				margin-right: 0.75rem;
				color: var(--rule, var(--paper-rule));
			}

			.article-shell__topic a:hover {
				text-decoration: underline;
				text-underline-offset: 0.24em;
			}

			.article-shell__header h1 {
				max-width: 980px;
				margin: 0;
				font-family: var(--font-serif);
				font-size: clamp(2.15rem, 4vw, 3.4rem);
				font-weight: 500;
				line-height: 1.48;
				letter-spacing: -0.045em;
				color: var(--ink);
				text-wrap: balance;
				word-break: keep-all;
				overflow-wrap: anywhere;
			}

			.article-shell__summary {
				max-width: 800px;
				margin: 1.25rem 0 0;
				font-family: var(--font-sans);
				font-size: clamp(1.05rem, 1.7vw, 1.18rem);
				line-height: 1.9;
				color: var(--muted, var(--ink-2));
				text-wrap: pretty;
				overflow-wrap: anywhere;
			}

			.article-shell__meta {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.6rem 1.35rem;
				margin-top: 1.85rem;
				font-size: 0.7rem;
				line-height: 1.6;
				color: var(--muted, var(--ink-3));
			}

			.article-shell__author {
				font-family: var(--font-sans);
				font-weight: 600;
				color: var(--ink);
			}

			.article-reading-grid {
				display: grid;
				grid-template-columns: minmax(0, 720px);
				justify-content: center;
				margin: 3rem auto 0;
			}

			.article-reading-grid--toc {
				grid-template-columns: 180px minmax(0, 720px);
				column-gap: 54px;
				max-width: 954px;
				justify-content: center;
			}

			.article-reading-column {
				min-width: 0;
			}

			.article-prose {
				min-width: 0;
				font-family: var(--font-sans);
				font-size: 19px;
				line-height: 1.85;
				color: var(--ink);
				overflow-wrap: anywhere;
			}

			:global(.article-prose > :first-child) {
				margin-top: 0;
			}

			:global(.article-prose p) {
				margin: 0 0 1.55rem;
				font-size: inherit;
				line-height: inherit;
				color: inherit;
				overflow-wrap: anywhere;
			}

			:global(.article-prose h2),
			:global(.article-prose h3),
			:global(.article-prose h4) {
				font-family: var(--font-serif);
				font-weight: 500;
				letter-spacing: -0.025em;
				color: var(--ink);
				word-break: keep-all;
				overflow-wrap: anywhere;
				scroll-margin-top: calc(var(--header-height, 5rem) + 1rem);
			}

			:global(.article-prose h2) {
				margin: 3.55rem 0 1rem;
				font-size: clamp(1.65rem, 3vw, 2rem);
				line-height: 1.55;
			}

			:global(.article-prose h3) {
				margin: 2.6rem 0 0.8rem;
				font-size: clamp(1.35rem, 2.5vw, 1.65rem);
				line-height: 1.6;
			}

			:global(.article-prose h4) {
				margin: 2.2rem 0 0.7rem;
				font-size: 1.25rem;
				line-height: 1.6;
			}

			:global(.article-prose a) {
				color: var(--accent, #a33a24);
				text-decoration: underline;
				text-decoration-color: color-mix(in srgb, var(--accent, #a33a24) 45%, transparent);
				text-decoration-thickness: 1px;
				text-underline-offset: 0.18em;
				overflow-wrap: anywhere;
			}

			:global(.article-prose a:hover) {
				text-decoration-thickness: 2px;
			}

			:global(.article-prose strong),
			:global(.article-prose b) {
				font-weight: 600;
				color: var(--ink);
			}

			:global(.article-prose ul),
			:global(.article-prose ol) {
				margin: 0 0 1.6rem;
				padding-left: 1.5rem;
			}

			:global(.article-prose li) {
				margin: 0.35rem 0;
				padding-left: 0.25rem;
				color: inherit;
			}

			:global(.article-prose blockquote) {
				margin: 2rem 0;
				padding: 0.2rem 0 0.2rem 1.25rem;
				border-left: 2px solid var(--accent, #a33a24);
				color: var(--muted, var(--ink-2));
				font-size: 0.96em;
			}

			:global(.article-prose hr) {
				margin: 3rem 0;
				border: 0;
				border-top: 1px solid var(--rule, var(--paper-rule));
			}

			:global(.article-prose code) {
				padding: 0.1em 0.28em;
				border: 1px solid var(--rule, var(--paper-rule));
				border-radius: 2px;
				background: var(--surface, var(--paper-2));
				color: var(--ink);
				font-family: var(--font-mono);
				font-size: 0.78em;
				word-break: break-word;
			}

			:global(.article-prose input[data-static-task-marker]) {
				width: 1em;
				height: 1em;
				margin: 0 0.35em 0 0;
				accent-color: var(--accent, #a33a24);
				pointer-events: none;
				vertical-align: -0.08em;
			}

			:global(.article-prose pre) {
				max-width: 100%;
				margin: 2rem 0;
				padding: 1.25rem;
				overflow-x: auto;
				overscroll-behavior-x: contain;
				border: 1px solid var(--rule, var(--paper-rule));
				border-radius: 0;
				background: var(--surface, var(--paper-2));
				color: var(--ink);
				font: 0.72em/1.75 var(--font-mono);
				tab-size: 2;
				overflow-wrap: normal;
			}

			:global(.article-prose pre[data-scroll-region='true']),
			:global(.article-prose table[data-scroll-region='true']) {
				outline-offset: 4px;
			}

			:global(.article-prose pre:focus-visible),
			:global(.article-prose table:focus-visible) {
				outline: 2px solid var(--focus-ring, var(--accent, #a33a24));
				outline-offset: 4px;
			}

			:global(.article-prose pre code) {
				padding: 0;
				border: 0;
				background: transparent;
				color: inherit;
				font: inherit;
				white-space: pre;
			}

			:global(.article-prose table) {
				display: block;
				max-width: 100%;
				margin: 2rem 0;
				overflow-x: auto;
				overscroll-behavior-x: contain;
				border-collapse: collapse;
				font-size: 0.76em;
				line-height: 1.6;
				white-space: normal;
			}

			:global(.article-prose th),
			:global(.article-prose td) {
				min-width: 8rem;
				padding: 0.75rem 0.8rem;
				border-top: 1px solid var(--rule, var(--paper-rule));
				text-align: left;
				vertical-align: top;
			}

			:global(.article-prose th) {
				font-weight: 600;
				color: var(--ink);
			}

			:global(.article-prose td) {
				color: var(--muted, var(--ink-2));
			}

			:global(.article-prose img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 2.25rem auto;
				border-radius: 0;
			}

			:global(.article-prose figure) {
				margin: 2.25rem 0;
			}

			:global(.article-prose figcaption) {
				margin-top: 0.6rem;
				color: var(--muted, var(--ink-2));
				font-size: 0.72em;
				line-height: 1.6;
			}

			.article-shell__hero {
				width: min(100%, 540px);
				margin: 0 0 2.25rem;
				border-block: 1px solid var(--rule, var(--paper-rule));
			}

			.article-shell__hero-image {
				display: block;
				width: 100%;
				max-height: 14rem;
				object-fit: cover;
			}

			.article-shell__after {
				max-width: 720px;
				margin: 4.25rem auto 0;
			}

			.article-shell__back {
				max-width: 720px;
				margin: 2.5rem auto 0;
				padding-top: 1rem;
				border-top: 1px solid var(--rule, var(--paper-rule));
				text-align: left;
			}

			.article-shell__back a {
				display: inline-flex;
				min-height: 2.75rem;
				align-items: center;
				color: var(--accent, #a33a24);
				font-size: 0.72rem;
				text-decoration: none;
			}

			.article-shell__back a::before {
				content: '←';
				margin-right: 0.55rem;
			}

			:global(.article-reading-column .faq-section) {
				margin-top: 3.5rem;
				padding: 2rem 0 0;
				background: transparent;
				border-top: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
				border-bottom: 0;
			}

			:global(.article-reading-column .faq-section > div) {
				max-width: none;
				padding-inline: 0;
			}

			:global(.article-reading-column .faq-section h2) {
				margin-bottom: 1.25rem;
				font-size: clamp(1.55rem, 3vw, 2rem);
			}

			:global(.article-reading-column .faq-item) {
				border: 0;
				border-top: 1px solid var(--rule, var(--paper-rule, #d8d1c5));
				border-radius: 0;
				background: transparent;
				overflow: visible;
			}

			:global(.article-reading-column .faq-question) {
				min-height: 2.75rem;
