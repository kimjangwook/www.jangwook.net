---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { filterPostsByDate } from '../lib/content';
import { getPostPath, type BlogPost } from '../lib/blog';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = await getCollection('blog');
const publishedPosts = filterPostsByDate(allPosts);

const languageMeta = [
	{
		code: 'ko',
		name: '한국어',
		label: '김장욱의 기술 블로그',
		description: 'AI와 웹 개발, 자동화에서 확인한 사실과 남은 질문을 한국어로 기록합니다.',
	},
	{
		code: 'en',
		name: 'English',
		label: "Kim Jangwook's technical notes",
		description: 'Questions, evidence, and unanswered questions from AI, web development, and automation.',
	},
	{
		code: 'ja',
		name: '日本語',
		label: 'Kim Jangwookの技術ノート',
		description: 'AI、ウェブ開発、自動化で確かめたことと残る問いを記録します。',
	},
	{
		code: 'zh',
		name: '简体中文',
		label: 'Kim Jangwook 的技术笔记',
		description: '记录 AI、网页开发和自动化中确认过的事实与尚未解决的问题。',
	},
] as const;

type LanguageCode = typeof languageMeta[number]['code'];

const latestPostsByLanguage = Object.fromEntries(
	languageMeta.map(({ code }) => [
		code,
		publishedPosts
			.filter((post) => post.id.startsWith(`${code}/`))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
			.slice(0, 3),
	]),
) as Record<LanguageCode, BlogPost[]>;

const formatDate = (date: Date, lang: LanguageCode) => new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : lang, {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
}).format(date);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header lang="en" />

		<main id="main-content" tabindex="-1" class="root-content">
			<section class="root-intro" aria-labelledby="root-title">
				<p class="root-eyebrow">CONTEMPORARY NOTES ON TECHNOLOGY</p>
				<h1 id="root-title">jangwook<span>.</span>net</h1>
				<p>Technical notes on AI, web development, and automation. Choose a language to read the questions, evidence, and decisions behind each column.</p>
			</section>

			<section class="root-languages" aria-labelledby="language-title">
				<div class="root-section-label">
					<h2 id="language-title">Read in your language</h2>
				</div>
				<div class="root-language-list">
					{languageMeta.map((language) => (
						<a class="root-language" href={`/${language.code}/`} lang={language.code}>
							<span class="root-language__code">{language.code.toUpperCase()}</span>
							<span class="root-language__copy">
								<strong>{language.name}</strong>
								<span>{language.label}</span>
								<small>{language.description}</small>
							</span>
							<span class="root-language__arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>

			<section class="root-latest" aria-labelledby="root-latest-title">
				<div class="root-section-label">
					<h2 id="root-latest-title">Recent writing</h2>
				</div>
				<div class="root-latest__grid">
					{languageMeta.map((language) => (
						<section class="root-latest__locale" aria-labelledby={`latest-${language.code}`}>
							<header>
								<h3 id={`latest-${language.code}`} lang={language.code}>{language.name}</h3>
								<a href={`/${language.code}/blog/`}>Archive <span aria-hidden="true">→</span></a>
							</header>
							<ul>
								{latestPostsByLanguage[language.code].map((post) => (
									<li>
										<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, language.code)}</time>
										<a href={getPostPath(language.code, post)} lang={language.code}>{post.data.title}</a>
										<p lang={language.code}>{post.data.description}</p>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			</section>
		</main>

		<Footer lang="en" />
	</body>
</html>

<style>
	.root-content {
		width: min(var(--page-width), calc(100% - 6rem));
		margin-inline: auto;
	}

	.root-intro {
		max-width: 46rem;
		padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5rem);
	}

	.root-eyebrow {
		margin: 0;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		line-height: 1.5;
	}

	.root-intro h1 {
		margin: 1rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(3.5rem, 9vw, 6rem);
		font-weight: 500;
		letter-spacing: -0.065em;
		line-height: 1;
	}

	.root-intro h1 span {
		color: var(--accent);
	}

	.root-intro > p:last-child {
		max-width: 40rem;
		margin: 1.45rem 0 0;
		color: var(--muted);
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.9;
	}

	.root-section-label {
		padding-block: 1.2rem 1.3rem;
		border-top: 1px solid var(--ink);
	}

	.root-section-label h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.45rem, 3vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.4;
	}

	.root-language-list {
		border-top: 1px solid var(--paper-rule);
	}

	.root-language {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr) 2rem;
		gap: 1.3rem;
		align-items: center;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--paper-rule);
		color: var(--ink);
		text-decoration: none;
	}

	.root-language:hover {
		color: var(--accent);
	}

	.root-language__code {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.root-language__copy {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.root-language__copy strong {
		font-family: var(--font-sans);
		font-size: 1.3rem;
		font-weight: 500;
		line-height: 1.4;
	}

	.root-language__copy span,
	.root-language__copy small {
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.6;
	}

	.root-language__copy small {
		font-size: 0.78rem;
	}

	.root-language__arrow {
		color: var(--accent);
		font-size: 1.2rem;
		text-align: right;
	}

	.root-latest {
		padding-top: clamp(4rem, 8vw, 6rem);
	}

	.root-latest__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 3rem clamp(2rem, 6vw, 5rem);
	}

	.root-latest__locale,
	.root-latest__locale header,
	.root-latest__locale li {
		min-width: 0;
	}

	.root-latest__locale header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.7rem;
		border-bottom: 1px solid var(--paper-rule);
	}

	.root-latest__locale h3 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 1.35rem;
		font-weight: 500;
	}

	.root-latest__locale header a {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		text-decoration: underline;
		white-space: nowrap;
	}

	.root-latest__locale ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.root-latest__locale li {
		padding: 1rem 0;
		border-bottom: 1px solid var(--paper-rule);
	}

	.root-latest__locale time {
		display: block;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
	}

	.root-latest__locale li > a {
		display: inline-block;
		margin-top: 0.25rem;
		color: var(--ink);
		font-family: var(--font-sans);
		font-size: 1.15rem;
		line-height: 1.55;
	}

	.root-latest__locale li > a:hover {
		color: var(--accent);
	}

	.root-latest__locale li p {
		margin: 0.3rem 0 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.8;
	}

	@media (max-width: 1100px) {
		.root-content {
			width: min(var(--page-width), calc(100% - 4rem));
		}
	}

	@media (max-width: 820px) {
		.root-content {
			width: calc(100% - 2.5rem);
		}

		.root-latest__grid {
			grid-template-columns: 1fr;
			gap: 2.6rem;
		}
	}

	@media (max-width: 540px) {
		.root-content {
			width: calc(100% - 2rem);
		}

		.root-intro {
			padding-block: 3.2rem 3.4rem;
		}

		.root-intro h1 {
			font-size: clamp(3rem, 16vw, 4.2rem);
		}

		.root-language {
			grid-template-columns: 3.1rem minmax(0, 1fr) 1.5rem;
			gap: 0.75rem;
		}

		.root-language__copy strong {
			font-size: 1.2rem;
		}

		.root-language__copy span,
		.root-language__copy small {
			font-size: 0.75rem;
		}
	}

	@media (max-width: 359px) {
		.root-content {
			width: calc(100% - 1.5rem);
		}
	}
</style>
