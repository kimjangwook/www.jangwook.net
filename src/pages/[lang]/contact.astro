---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getStaticPaths as getI18nStaticPaths } from '../../lib/i18n/utils';
import { useTranslations, type Language } from '../../lib/i18n/languages';

export function getStaticPaths() {
	return getI18nStaticPaths();
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const contactInfo = {
	ko: {
		intro: '글이나 프로젝트에 대해 궁금한 점이 있다면 아래 이메일로 편하게 연락해 주세요. 감사합니다.',
		emailTitle: '이메일',
		emailDesc: '협업, 기술 질문, 피드백을 환영합니다. 보통 1~2 영업일 안에 답변드립니다.',
		socialTitle: '소셜 링크',
		socialDesc: '공개 채널에서도 소식을 확인할 수 있습니다.',
		aboutTitle: '블로그 소개',
		aboutDesc: 'jangwook.net은 AI 에이전트, 개발 도구, 소프트웨어 제작 경험을 기록하는 개인 기술 블로그입니다.',
	},
	ja: {
		intro: '記事やプロジェクトについてご質問があれば、以下のメールアドレスまでお気軽にご連絡ください。',
		emailTitle: 'メール',
		emailDesc: '協業、技術的な質問、フィードバックを歓迎します。通常1〜2営業日以内に返信します。',
		socialTitle: 'ソーシャルリンク',
		socialDesc: '公開チャンネルでも近況をご覧いただけます。',
		aboutTitle: 'ブログについて',
		aboutDesc: 'jangwook.netは、AIエージェント、開発ツール、ソフトウェア制作の経験を記録する個人技術ブログです。',
	},
	zh: {
		intro: '如果您对文章或项目有任何问题，欢迎通过以下邮箱联系。谢谢。',
		emailTitle: '电子邮件',
		emailDesc: '欢迎合作、技术问题和反馈。通常会在1-2个工作日内回复。',
		socialTitle: '社交链接',
		socialDesc: '您也可以在公开渠道查看最新动态。',
		aboutTitle: '博客简介',
		aboutDesc: 'jangwook.net 是 Kim Jangwook 记录 AI 代理、开发工具和软件构建经验的个人技术博客。',
	},
	en: {
		intro: "If you have a question about an article or project, please email me below. Thank you.",
		emailTitle: 'Email',
		emailDesc: 'Collaboration requests, technical questions, and feedback are welcome. I usually reply within 1–2 business days.',
		socialTitle: 'Social Links',
		socialDesc: 'You can also find updates on these public channels.',
		aboutTitle: 'About This Blog',
		aboutDesc: 'jangwook.net is Kim Jangwook’s personal technology blog about AI agents, developer tools, and building software.',
	},
};

const info = contactInfo[lang] || contactInfo.en;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('nav.contact')} description={t('contact.description')} />
	</head>
	<body>
		<Header lang={lang} />
		<main id="main-content" tabindex="-1" class="contact-page">
			<h1 class="contact-page__title">{t('nav.contact')}</h1>

			<div class="contact-page__intro prose prose-lg max-w-none mb-12 dark:prose-invert">
				<p class="text-lg text-gray-600 dark:text-gray-300">{info.intro}</p>
			</div>

			<!-- Contact Methods -->
			<div class="contact-methods grid md:grid-cols-2 gap-6 mb-12">
				<!-- Email -->
				<div class="contact-method bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
					<div class="flex items-center gap-3 mb-4">
						<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
						<h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">{info.emailTitle}</h2>
					</div>
					<a href="mailto:me@jangwook.net" class="text-accent hover:underline text-lg font-medium block mb-3 [overflow-wrap:anywhere]">
						me@jangwook.net
					</a>
					<p class="text-sm text-gray-600 dark:text-gray-400">{info.emailDesc}</p>
				</div>

				<!-- Social Media -->
				<div class="contact-method bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
					<div class="flex items-center gap-3 mb-4">
						<svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
						</svg>
						<h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">{info.socialTitle}</h2>
					</div>
					<div class="space-y-2">
						<a href="https://x.com/Kim_Jangwook" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline block">
							𝕏 (Twitter): @Kim_Jangwook
						</a>
						<a href="https://linkedin.com/in/jangwook-kim-2590a1174" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline block">
							LinkedIn: Jangwook Kim
						</a>
						<a href="https://github.com/kimjangwook" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline block">
							GitHub: kimjangwook
						</a>
					</div>
					<p class="text-sm text-gray-600 dark:text-gray-400 mt-3">{info.socialDesc}</p>
				</div>
			</div>

			<!-- About Section (adds crawlable content) -->
			<div class="contact-page__about bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-8 mb-12">
				<h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">{info.aboutTitle}</h2>
				<p class="text-gray-600 dark:text-gray-300 leading-relaxed">{info.aboutDesc}</p>
			</div>

		</main>
		<Footer lang={lang} />

		<style>
			.contact-page {
				width: min(var(--reading-width), calc(100% - 6rem));
				margin-inline: auto;
				padding-block: clamp(3.5rem, 7vw, 5.5rem) 5rem;
			}

			.contact-page__title {
				margin: 0;
				font-family: var(--font-serif);
				font-size: clamp(2.8rem, 6vw, 4.5rem);
				font-weight: 500;
				letter-spacing: -0.05em;
				line-height: 1.2;
			}

			.contact-page__intro {
				max-width: 38rem;
				margin-top: 1.5rem;
			}

			.contact-page__intro p {
				margin: 0;
				color: var(--muted);
				font-size: 1.05rem;
				line-height: 1.9;
			}

			.contact-methods {
				gap: 2.5rem;
			}

			.contact-method {
				padding: 1.35rem 0 1.6rem;
				background: transparent;
				border: 0;
				border-top: 1px solid var(--paper-rule);
				border-radius: 0;
				box-shadow: none;
			}

			.contact-method h2,
			.contact-page__about h2 {
				font-family: var(--font-serif);
				font-weight: 500;
				color: var(--ink);
			}

			.contact-method svg {
				width: 1.2rem;
				height: 1.2rem;
				color: var(--accent);
			}

			.contact-method a {
				color: var(--accent);
				font-family: var(--font-sans);
				font-weight: 600;
			}

			.contact-method p,
			.contact-page__about p {
				color: var(--muted);
				line-height: 1.85;
			}

			.contact-page__about {
				margin-top: 1rem;
				padding: 1.4rem 0 0;
				background: transparent;
				border: 0;
				border-top: 1px solid var(--ink);
				border-radius: 0;
				box-shadow: none;
			}

			@media (max-width: 820px) {
				.contact-page {
					width: calc(100% - 2.5rem);
				}
			}

			@media (max-width: 540px) {
				.contact-page {
					width: calc(100% - 2rem);
					padding-block: 2.8rem 4rem;
				}

				.contact-page__title {
					font-size: 2.8rem;
				}
			}
		</style>
	</body>
</html>
