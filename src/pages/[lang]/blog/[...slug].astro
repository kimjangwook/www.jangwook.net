---
import { getCollection, render } from 'astro:content';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BlogPost from '../../../layouts/BlogPost.astro';
import { type Language } from '../../../lib/i18n/languages';
import { filterPostsByDate, calculateReadingTime } from '../../../lib/content';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const posts = filterPostsByDate(allPosts);

	return posts.map((post) => {
		const postLang = post.id.split('/')[0];
		return {
			params: { lang: postLang, slug: post.id },
			props: post,
		};
	});
}

const { lang } = Astro.params as { lang: Language };
const post = Astro.props;
const { Content } = await render(post);
const readingTime = calculateReadingTime(post.body ?? '');
if (!post.filePath) {
	throw new Error(`Missing source path for blog article: ${post.id}`);
}
const articleSourceSha256 = createHash('sha256')
	.update(readFileSync(resolve(process.cwd(), post.filePath)))
	.digest('hex');
---

<BlogPost
	{...post.data}
	lang={lang}
	tags={post.data.tags}
	postId={post.id}
	noindex={post.data.noindex}
	relatedPosts={post.data.relatedPosts}
	readingTime={readingTime}
	articleSourceSha256={articleSourceSha256}
>
	<Content />
</BlogPost>
