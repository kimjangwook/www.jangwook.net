---

<div id="reading-progress-container" aria-hidden="true">
	<div id="reading-progress" class="reading-progress"></div>
</div>

<script>
  const initialiseReadingProgress = () => {
    const progressBar = document.getElementById('reading-progress');
    const readingContent = document.querySelector<HTMLElement>('[data-reading-content]');
    if (!progressBar || !readingContent) return;

    const updateProgress = () => {
      const start = readingContent.getBoundingClientRect().top + window.scrollY;
      const end = start + readingContent.offsetHeight;
      const travel = Math.max(end - start - window.innerHeight * 0.35, 1);
      const progress = Math.min(Math.max(((window.scrollY + window.innerHeight * 0.35 - start) / travel) * 100, 0), 100);

      progressBar.style.setProperty('--reading-progress', `${progress}%`);
      progressBar.style.width = `${progress}%`;
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    updateProgress();
    window.addEventListener('resize', updateProgress, { passive: true });
    window.addEventListener('load', updateProgress, { once: true });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseReadingProgress, { once: true });
  } else {
    initialiseReadingProgress();
  }
</script>

<style>
	#reading-progress-container {
		position: fixed;
		inset: 0 0 auto;
		z-index: 30;
		height: 2px;
		pointer-events: none;
		background: transparent;
	}

	#reading-progress {
		height: 100%;
		width: var(--reading-progress, 0%);
		background: var(--accent, #a33a24);
		transform-origin: left center;
		transition: width 160ms linear;
	}

	@media (prefers-reduced-motion: reduce) {
		#reading-progress {
			transition: none;
		}
	}
</style>
