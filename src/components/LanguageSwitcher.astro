---
import { languages, type Language } from '../lib/i18n/languages';
import { getRouteFromUrl } from '../lib/i18n/utils';

interface Props {
	currentLang: Language;
	/** Actual equivalent URLs when a route has locale-specific availability. */
	links?: Partial<Record<Language, string>>;
}

const { currentLang, links } = Astro.props;
const currentRoute = getRouteFromUrl(Astro.url.pathname);
const languageCodes: Record<Language, string> = {
	ko: 'KO',
	en: 'EN',
	ja: 'JA',
	zh: 'ZH',
};
---

<nav class="language-switcher" aria-label="Select language">
	{Object.entries(languages).map(([lang, label]) => {
		const language = lang as Language;
		const defaultHref = `/${language}${currentRoute.replace(/{LANG}/g, language)}`;
		const href = links?.[language] ?? defaultHref;

		return (
			<a
				href={href}
				class:list={['language-switcher__item', { 'is-active': language === currentLang }]}
				data-lang={language}
				aria-current={language === currentLang ? 'page' : undefined}
				aria-label={label}
				title={label}
			>
				<span class="language-switcher__code">{languageCodes[language]}</span>
				<span class="language-switcher__label">{label}</span>
			</a>
		);
	})}
</nav>

<style>
	.language-switcher {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.1rem;
		padding: 0;
		border: 0;
		background: transparent;
	}

	.language-switcher__item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.3rem;
		min-height: 44px;
		padding: 0.3rem 0.28rem;
		border-bottom: 2px solid transparent;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-decoration: none;
	}

	.language-switcher__item:hover {
		color: var(--ink);
	}

	.language-switcher__item.is-active {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}

	.language-switcher__code {
		line-height: 1;
	}

	.language-switcher__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 720px) {
		.language-switcher__item {
			min-width: 2.2rem;
		}
	}
</style>

<script>
	import { saveLanguagePreference, type SupportedLanguage } from '../lib/language-detection';

	document.querySelectorAll<HTMLAnchorElement>('.language-switcher__item[data-lang]').forEach((link) => {
		link.addEventListener('click', () => {
			const lang = link.dataset.lang as SupportedLanguage | undefined;
			if (lang) saveLanguagePreference(lang);
		});
	});
</script>
