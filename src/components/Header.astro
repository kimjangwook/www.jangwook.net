---
import { SITE_TITLE } from "../consts";
import { useTranslations, type Language } from "../lib/i18n/languages";
import BrandMark from "./BrandMark.astro";
import HeaderLink from "./HeaderLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Skip link: WCAG 2.4.1 (Bypass Blocks) — first focusable element, visible only on keyboard focus -->
<a href="#main-content" class="skip-link">{t("a11y.skipToContent")}</a>

<header
  class="site-header sticky top-0 z-50 backdrop-blur-sm border-b"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="site-header__row flex items-center justify-between min-h-20 gap-4">
      <div class="flex items-center gap-6">
        <!-- Mobile menu button (shown on mobile and tablet) -->
        <!-- UX: Touch target minimum 44x44px (Fitts's Law) -->
        <button
          id="mobile-menu-button"
          class="lg:hidden p-2 rounded-md transition-all duration-200 touch-target"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="menu-icon-open"
            class="w-6 h-6 transition-transform duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="w-6 h-6 hidden transition-transform duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <h2 class="brand-heading">
          <a
            href={`/${lang}/`}
            class="brand-link"
            aria-label={SITE_TITLE}
          >
            <BrandMark showWordmark size={42} />
          </a>
        </h2>
        <!-- UX: Navigation limited to 6 items (Miller's Law - 7±2 rule) -->
        <div class="hidden lg:flex items-center gap-1">
          <HeaderLink href={`/${lang}/`}>{t("nav.home")}</HeaderLink>
          <HeaderLink href={`/${lang}/blog/`}>{t("nav.blog")}</HeaderLink>
          <HeaderLink href={`/${lang}/about/`}>{t("nav.about")}</HeaderLink>
          <HeaderLink href={`/${lang}/contact/`}>{t("nav.contact")}</HeaderLink>
          <HeaderLink href={`/${lang}/social/`}>{t("nav.social")}</HeaderLink>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <LanguageSwitcher currentLang={lang} />
      </div>
    </div>

    <!-- Mobile menu with smooth animation (shown on mobile and tablet) -->
    <!-- UX: Smooth transitions (Doherty Threshold - < 400ms feels instant) -->
    <div
      id="mobile-menu"
      class="mobile-menu lg:hidden border-t"
      aria-hidden="true"
      inert
    >
      <div class="flex flex-col gap-2 py-4">
        <HeaderLink href={`/${lang}/`}>{t("nav.home")}</HeaderLink>
        <HeaderLink href={`/${lang}/blog/`}>{t("nav.blog")}</HeaderLink>
        <HeaderLink href={`/${lang}/about/`}>{t("nav.about")}</HeaderLink>
        <HeaderLink href={`/${lang}/contact/`}>{t("nav.contact")}</HeaderLink>
        <HeaderLink href={`/${lang}/social/`}>{t("nav.social")}</HeaderLink>
      </div>
    </div>
  </nav>
</header>

<style>
  /* Skip link — off-screen until focused, then anchored top-left above the sticky header */
  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: top 0.15s ease-in-out;
  }

  .skip-link:focus {
    top: 0.75rem;
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }

  .site-header {
    background: color-mix(in oklch, var(--paper) 92%, transparent);
    border-color: var(--paper-rule);
  }

  /* WCAG 1.4.10 Reflow (320 CSS px). 브랜드 + 테마 토글 + 언어 전환의 고유 폭
     합이 288px(320 - 좌우 패딩)를 2px 넘겨 가로 스크롤이 생겼다. 여백만
     줄여 넘김을 없앤다. 넓은 화면의 배치는 그대로 둔다. */
  @media (max-width: 400px) {
    .site-header > nav {
      padding-inline: 0.75rem;
    }

    .site-header__row {
      gap: 0.5rem;
    }
  }

  /* 400% 확대 시 뷰포트 높이는 200 CSS px까지 줄어든다. 그 화면에서 82px짜리
     sticky 헤더는 세로의 41%를 상시 점유한다. 짧은 뷰포트에서는 헤더를
     흐름 안으로 되돌려 본문에 높이를 돌려준다. */
  @media (max-height: 400px) {
    .site-header {
      position: static;
    }
  }

  .brand-heading {
    margin: 0;
    line-height: 1;
  }

  .brand-link {
    display: inline-flex;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-link:hover {
    color: var(--ink);
  }

  #mobile-menu-button {
    color: var(--ink-2);
  }

  #mobile-menu-button:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  #mobile-menu {
    border-color: var(--paper-rule);
  }
</style>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.contains("open");

      if (isOpen) {
        // Close menu
        mobileMenu.classList.remove("open");
        mobileMenuButton.setAttribute("aria-expanded", "false");
        mobileMenu.setAttribute("aria-hidden", "true");
        mobileMenu.setAttribute("inert", "");
        menuIconOpen?.classList.remove("hidden");
        menuIconClose?.classList.add("hidden");
      } else {
        // Open menu
        mobileMenu.classList.add("open");
        mobileMenuButton.setAttribute("aria-expanded", "true");
        mobileMenu.setAttribute("aria-hidden", "false");
        mobileMenu.removeAttribute("inert");
        menuIconOpen?.classList.add("hidden");
        menuIconClose?.classList.remove("hidden");
      }
    });

    // Close menu when clicking a link
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("open");
        mobileMenuButton.setAttribute("aria-expanded", "false");
        mobileMenu.setAttribute("aria-hidden", "true");
        mobileMenu.setAttribute("inert", "");
        menuIconOpen?.classList.remove("hidden");
        menuIconClose?.classList.add("hidden");
      });
    });

    // Close menu on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobileMenu.classList.contains("open")) {
        mobileMenu.classList.remove("open");
        mobileMenuButton.setAttribute("aria-expanded", "false");
        mobileMenu.setAttribute("aria-hidden", "true");
        mobileMenu.setAttribute("inert", "");
        menuIconOpen?.classList.remove("hidden");
        menuIconClose?.classList.add("hidden");
        mobileMenuButton.focus();
      }
    });
  }
</script>
