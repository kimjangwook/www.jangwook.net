{
	// Cloudflare Workers 정적 자산 배포 설정 (GitHub Pages → Workers 이전, 2026-08-11)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "www-jangwook-net",
	"main": "worker/index.js",
	"compatibility_date": "2026-08-01",
	"routes": [
		{ "pattern": "jangwook.net", "custom_domain": true },
		{ "pattern": "www.jangwook.net", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// 브라우저 내비게이션 요청은 자산 미매칭 시 404 페이지가 워커보다 먼저
		// 서빙되므로, 리다이렉트 경로는 워커 우선으로 강제해야 한다
		"run_worker_first": ["/ads.txt"],
		// 디렉토리 URL 정규화: GitHub Pages와 동일하게 트레일링 슬래시 유지
		"html_handling": "auto-trailing-slash",
		// 404는 Astro가 생성한 404.html로 서빙
		"not_found_handling": "404-page"
	}
}
